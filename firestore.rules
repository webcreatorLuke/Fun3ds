rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Replace with your real admin email — must match ADMIN_EMAIL in
    // public/js/firebase-config.js and functions/index.js exactly.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "lukeplaysgamezandmore@gmail.com";
    }

    // Public catalog — anyone can browse, only the admin can change it.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders are created and updated only by Cloud Functions (admin SDK,
    // bypasses these rules). Clients may only read their own orders, or all
    // orders if they're the admin (for the dashboard).
    match /orders/{orderId} {
      allow read: if request.auth != null &&
                     (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Customers can create their own request and read their own requests.
    // Accept/decline happen only through the admin-only Cloud Functions.
    match /customRequests/{requestId} {
      allow create: if request.auth != null &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.status == "pending";
      allow read: if request.auth != null &&
                     (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }
  }
}
